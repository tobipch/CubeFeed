# PostgreSQL connection string (Neon / Vercel Postgres)
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Base URL used for cookie settings in production (optional)
# NEXTAUTH_URL=https://your-domain.com

# Cron Job Secret – beliebiger langer zufälliger String, z.B. openssl rand -hex 32
CRON_SECRET=dein_cron_secret_hier

# WCA OAuth (https://www.worldcubeassociation.org/oauth/applications)
WCA_CLIENT_ID=xUG5WieliR3zqyz6U4XFOr8Zv-JcLYFzgLzrUfSXd14
WCA_CLIENT_SECRET=dein_secret_hier_eintragen
# Lokal:
WCA_REDIRECT_URI=http://localhost:3000/api/auth/wca/callback
# Produktion (auskommentieren und anpassen):
# WCA_REDIRECT_URI=https://deine-domain.com/api/auth/wca/callback
